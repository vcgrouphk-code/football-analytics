# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 舊版 JWT anon key 仍可用，與上一行二擇一
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# 舊版 service role 仍可用，與上一行二擇一
# SUPABASE_SERVICE_ROLE_KEY=

# 外部賽事 API（例如 API-Football / football-data.org）
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_API_KEY=

# football-data.org 免費 token（本季賽程、比分、積分榜）
# https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# 開發伺服器會每 15 分鐘同步已追蹤的 football-data 聯賽。
# 外部排程可呼叫 GET 或 POST /api/sync，需帶 Authorization: Bearer <secret>
CRON_SECRET=change-me-in-production
